generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  role     Role   @default(USER)
}

enum Condition {
  excellent
  good
  fair
  poor
}

model Stuff {
  id        Int       @id @default(autoincrement())
  name      String
  quantity  Int
  condition Condition @default(good)
  owner     String
}

model Review {
  id            Int @id @default(autoincrement())
  placeName     String
  content       String
  createdAt     DateTime @default(now())
  owner         String
  photos        Photo[]
  elevatorId    Int?
}

model Photo {
  id          Int     @id @default(autoincrement())
  reviewId    Int
  elevatorId  Int?
  source      String
  owner       String
  review      Review  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

model Elevator {
  id            Int     @id @default(autoincrement())
  latitude      Float
  longitude     Float
  location      String
}