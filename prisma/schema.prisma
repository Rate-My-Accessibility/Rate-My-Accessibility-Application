// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
  role     Role   @default(USER)
  elevatorRatings ElevatorRating[]
}

// NOTE: Prisma does not support composite types on Postgres.
// CURRENT SOLUTION: Use an array instead and handle the structure in our TypeScript.

model Elevator {
  id              Int           @id @default(autoincrement())
  name            String
  photos          String[]
  // order: [speed, size, availability, crowding, reliability, cleanliness]
  scores          Float[]
  coordinates     Float[]
  elevatorRatings ElevatorRating[]
}

model ElevatorRating {
  id        Int    @id @default(autoincrement())
  elevator  Elevator @relation(fields: [elevatorId], references: [id])
  elevatorId Int
  user      User   @relation(fields: [userId], references: [id])
  userId    Int
  scores    Float[]
}